+static int mtcr_ch34x_open(mfile* mf, const char* name)
+{
+    unsigned int bus = 0;
+    unsigned int addr = 0;
+
+    if (strcmp(name, "ch34x") != 0 && sscanf(name, "ch34x:%x.%x", &bus, &addr) != 2)
+    {
+        errno = EINVAL;
+        return -1;
+    }
+
+    (void)bus;
+    (void)addr;
+
+    mf->i2c_transact = ch34x_transact;
+
+    errno = ENOSYS;
+    return -1;
+}
